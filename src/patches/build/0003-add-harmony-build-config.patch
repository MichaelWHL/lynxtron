diff --git a/rust/BUILD.gn b/rust/BUILD.gn
index 68a9290..be94c86 100644
--- a/rust/BUILD.gn
+++ b/rust/BUILD.gn
@@ -110,3 +110,11 @@ config("is_gtest_unittests") {
     "is_gtest_unittests",
   ]
 }
+
