From 7cf981c9dbf932f6bbb706d3e0132b908bb56860 Mon Sep 17 00:00:00 2001
From: Lynxtron Scripts <scripts@lynxtron>
Date: Fri, 8 May 2026 16:28:47 +0800
Subject: [PATCH 4/5] Accept unknown -W flags on harmony (ohos clang 19 vs
 chromium clang 21+)

---
 config/compiler/BUILD.gn | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/config/compiler/BUILD.gn b/config/compiler/BUILD.gn
index bb275b7..2c549f1 100644
--- a/config/compiler/BUILD.gn
+++ b/config/compiler/BUILD.gn
@@ -398,7 +398,11 @@ config("lynx_disable_warning_config") {
       "-Wno-unsafe-buffer-usage-in-libc-call",
     ]
   } else {
-    config_flags = []
+    # ohos clang 19 doesn't recognize warnings introduced in clang 21+ that
+    # mainline chromium adds (e.g. -Wno-nontrivial-memcall). Globally accept
+    # unknown -W options so chromium's warning suppression list can include
+    # newer-clang flags without breaking the build on the older NDK clang.
+    config_flags = [ "-Wno-unknown-warning-option" ]
   }
   cflags = config_flags
   cflags_cc = config_flags
-- 
