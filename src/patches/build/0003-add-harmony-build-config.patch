+  # Stub for non-rust toolchains (e.g. HarmonyOS bring-up with enable_rust=false).
+  # Various C++ targets unconditionally depend on //build/rust:cxx_cppdeps;
+  # provide an empty group so dependency resolution succeeds.
+  group("cxx_cppdeps") {
+  }
+}
