From 32364035af920ff614d818e75e21607808b9b8f2 Mon Sep 17 00:00:00 2001
From: Lynxtron Scripts <scripts@lynxtron>
Date: Fri, 8 May 2026 17:37:13 +0800
Subject: [PATCH 5/5] Define OS_HARMONY + BUILDFLAG(IS_HARMONY) when __OHOS__

---
 build_config.h | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/build_config.h b/build_config.h
index 38bc688..a781089 100644
--- a/build_config.h
+++ b/build_config.h
@@ -94,6 +94,11 @@
 // The OS_CHROMEOS macro is defined in GN.
 #define OS_LINUX 1
 #endif  // !defined(OS_CHROMEOS)
+// OpenHarmony NDK clang advertises __OHOS__ as a kernel-level OS marker.
+// Treat it as a sibling of OS_LINUX (same kernel, musl libc, ohos uapi).
+#if defined(__OHOS__)
+#define OS_HARMONY 1
+#endif
 // Include a system header to pull in features.h for glibc/uclibc macros.
 #include <assert.h>
 #if defined(__GLIBC__) && !defined(__UCLIBC__)
@@ -159,6 +164,12 @@
 #define BUILDFLAG_INTERNAL_IS_ANDROID() (0)
 #endif
 
+#if defined(OS_HARMONY)
+#define BUILDFLAG_INTERNAL_IS_HARMONY() (1)
+#else
+#define BUILDFLAG_INTERNAL_IS_HARMONY() (0)
+#endif
+
 #if defined(OS_APPLE)
 #define BUILDFLAG_INTERNAL_IS_APPLE() (1)
 #else
-- 
