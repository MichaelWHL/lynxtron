From a2d287a6779d597fcf656323e7af1133de4f8256 Mon Sep 17 00:00:00 2001
From: Lynxtron Scripts <scripts@lynxtron>
Date: Fri, 8 May 2026 16:05:32 +0800
Subject: [PATCH] Treat is_harmony as linux for os_include selection

---
 third_party/libxml/BUILD.gn | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/third_party/libxml/BUILD.gn b/third_party/libxml/BUILD.gn
index 5780cb8..554d758 100644
--- a/third_party/libxml/BUILD.gn
+++ b/third_party/libxml/BUILD.gn
@@ -4,7 +4,7 @@
 
 # Define an "os_include" variable that points at the OS-specific generated
 # headers.  These were generated by running the configure script offline.
-if (is_linux || is_chromeos || is_android || is_fuchsia) {
+if (is_linux || is_chromeos || is_android || is_fuchsia || is_harmony) {
   os_include = "linux"
 } else if (is_apple) {
   os_include = "mac"
