From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lynxtron Authors <lynxtron@example.com>
Date: Tue, 21 Jul 2026 18:45:00 +0800
Subject: [PATCH] Link qos on HarmonyOS

---
 core/base/BUILD.gn | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/core/base/BUILD.gn b/core/base/BUILD.gn
index 08c8a157..5b985083 100644
--- a/core/base/BUILD.gn
+++ b/core/base/BUILD.gn
@@ -153,6 +153,9 @@ lynx_core_source_set("base") {
     if (is_win) {
       libs += [ "user32.lib" ]
     }
+    if (is_harmony) {
+      libs += [ "qos" ]
+    }
 
     if (is_headless) {
       defines = [ "ENABLE_HEADLESS" ]
