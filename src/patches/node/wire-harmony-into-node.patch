From 2622e83e3a8e4eed5faa318a8aa5b3c0593a91b7 Mon Sep 17 00:00:00 2001
From: Lynxtron Scripts <scripts@lynxtron>
Date: Fri, 8 May 2026 18:15:55 +0800
Subject: [PATCH 3/3] Resolve gn from lynxtron's buildtools/gn (avoid distro
 /usr/bin/gn)

---
 tools/generate_config_gypi.py | 21 ++++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

diff --git a/tools/generate_config_gypi.py b/tools/generate_config_gypi.py
index 296ec4c1..58c207b2 100755
--- a/tools/generate_config_gypi.py
+++ b/tools/generate_config_gypi.py
@@ -19,7 +19,26 @@ import getnapibuildversion
 
 # Regex used for parsing results of "gn args".
 GN_RE = re.compile(r'(\w+)\s+=\s+(.*?)$', re.MULTILINE)
-GN = 'gn.exe' if sys.platform == 'win32' else 'gn'
+
+# Resolve the gn executable. Lynxtron ships its own gn under buildtools/gn/
+# (compatible with the chromium build files). Some host systems have a
+# distro-shipped /usr/bin/gn that doesn't understand `path_exists()` and
+# breaks on lynxtron's siso.gni. Prefer lynxtron's own gn when this file is
+# resolved relative to the lynxtron source tree.
+def _resolve_gn():
+  if sys.platform == 'win32':
+    gn_name = 'gn.exe'
+  else:
+    gn_name = 'gn'
+  # tools/ is at <lynxtron-root>/third_party/node/tools/
+  here = os.path.dirname(os.path.abspath(__file__))
+  lynxtron_root = os.path.abspath(os.path.join(here, '..', '..', '..'))
+  candidate = os.path.join(lynxtron_root, 'buildtools', 'gn', gn_name)
+  if os.path.exists(candidate):
+    return candidate
+  return gn_name
+
+GN = _resolve_gn()
 
 def bool_to_number(v):
   return 1 if v else 0
-- 
