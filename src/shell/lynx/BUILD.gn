import("//lynx/oliver/oliver.gni")
if (is_mac) {
  import("//build/apple/templates/darwin_general_bundle.gni")

  build_kernel_js("lynx_core") {
    script = "//lynx/tools/js_tools/build.py"
    platform = "ios"
    output_path = "$root_build_dir/lynx_lynxtron"
  }

  bundle_data("lynx_core_js") {
    sources = [ "$root_build_dir/lynx_lynxtron/lynx_core.js" ]
    outputs = [ "{{bundle_resources_dir}}/lynx_core.js" ]
    public_deps = [ ":lynx_core" ]
  }

  darwin_general_bundle("lynx_resources_bundle_for_lynxtron") {
    bundle_identifier = "com.lynx.LynxResources"
    info_plist =
        "//lynx/explorer/darwin/macos/lynx_explorer/Resource/Info.plist"
    deployment_target = mac_deployment_target
    output_name = "lynx_lynxtron/LynxResources"
    public_deps = [ ":lynx_core_js" ]
  }

  bundle_data("lynx_resources") {
    sources = [ "$root_build_dir/lynx_lynxtron/LynxResources.bundle" ]

    outputs = [ "{{bundle_contents_dir}}/Resources/{{source_file_part}}" ]
    public_deps = [ ":lynx_resources_bundle_for_lynxtron" ]
  }
} else if (is_win) {
  build_kernel_js("lynx_core") {
    script = "//lynx/tools/js_tools/build.py"
    platform = "ios"
    output_path = "$root_build_dir"
  }
}

group("lynx_lib") {
  deps = []
  if (is_mac) {
    deps += [ "//lynx/platform/darwin/macos:lynx_common_deps" ]
  } else if (is_win) {
    deps += [
      ":lynx_core",
      "//lynx/platform/windows:lynx_windows_group",
    ]
  } else if (is_harmony) {
    # HarmonyOS bring-up: lynx capi entries are stubbed inside the lynxtron
    # tree (see shell/api/lynx_view/lynx_capi_stubs_harmony.cc) instead of
    # pulling //lynx/platform/embedder:embedder, because the latter brings
    # in lynx/core/runtime/lepus/ir/* (~50 .cc) which require -fexceptions
    # and clash with lynxtron's -fno-exceptions cflag.
    # Real lynx integration (full embedder dep + lynx/platform/harmony group)
    # is tracked under WI-036.
    #
    # WI-035 wave A: wire the weak-node-api source build to provide the
    # ~30+ napi_*_weak symbol definitions (weak_napi_defines.h rewrites
    # napi_xxx -> napi_xxx_weak under USE_WEAK_SUFFIX_NAPI=1). The
    # weak_node_api_source source_set is platform-agnostic (only compiles
    # generated/weak_node_api.cpp) and its config already sets
    # NAPI_DISABLE_CPP_EXCEPTIONS so it composes with lynxtron's
    # -fno-exceptions cflag. This replaces the wave-D/E hand-written
    # napi_*_weak stubs with the real lynx-supplied definitions.
    deps += [
      "//lynx/third_party/weak-node-api:weak_node_api_source",
    ]
  }
  public_configs = [ "//lynx/platform/embedder:public_api" ]
}
