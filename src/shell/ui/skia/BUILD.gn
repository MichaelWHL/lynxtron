import("//build/buildflag_header.gni")
import("//build/config/compiler/compiler.gni")
import("//build/config/features.gni")

config("skia_ext_config") {
  include_dirs = [ ".." ]
}
component("skia_ext") {
  public_configs = [ ":skia_ext_config" ]
  public_deps = [
    "//base",
    "//third_party/skia",
  ]
  public = [
    "ext/convolver.h",
    "ext/image_operations.h",
    "ext/skcolorspace_primaries.h",
  ]
  sources = [
    "ext/convolver.cc",
    "ext/image_operations.cc",
    "ext/skcolorspace_primaries.cc",
  ]
  if (!is_harmony) {
    # SkMemory_new_handler.cpp provides sk_malloc / sk_free / sk_realloc /
    # sk_abort_no_print etc. as a chromium-flavored override of skia's
    # default SkMemory_malloc.cpp. On harmony we use shared_library link
    # mode (so the napi-init lib can be dlopen-ed by the OHOS HAP loader),
    # which keeps both .a's symbols alive instead of letting
    # -Wl,--gc-sections strip the loser. Drop the override on harmony so
    # skia's SkMemory_malloc.cpp wins cleanly. Real-impl can route skia
    # allocations through PartitionAlloc later (WI-037+) once harmony
    # has its own memory adapter strategy.
    sources += [ "ext/SkMemory_new_handler.cpp" ]
  }

  if (is_mac) {
    public += [ "ext/skia_utils_mac.h" ]
    sources += [ "ext/skia_utils_mac.mm" ]
  }

  if (is_win) {
    public += [ "ext/skia_utils_win.h" ]
    sources += [ "ext/skia_utils_win.cc" ]
  }

  if (current_cpu == "x86" || current_cpu == "x64") {
    sources += [
      "ext/convolver_SSE2.cc",
      "ext/convolver_SSE2.h",
    ]
  } else if (current_cpu == "arm" || current_cpu == "arm64") {
    if (arm_use_neon) {
      sources += [
        "ext/convolver_neon.cc",
        "ext/convolver_neon.h",
      ]
    }
  }
}
