declare_args() {
  # Compile the lynxtron_hello NAPI smoke-test module into lynxtron_lib.
  # Default off: this is test-only code and normally stays out of the shipped
  # library.  It registers into the napi module table at load, needed only for
  # the API demo / regression pages that call
  # lynx.getModuleLoader().load('lynxtron_hello').  Turn it on for a demo or
  # test build, never for a production release.
  lynxtron_build_hello_native_test = false

  # A list of extra dependencies to add to the root target. This allows a
  # checkout to add additional targets without explicitly changing any checked-
  # in files.
  lynxtron_lib_extra_configs = []
  lynxtron_lib_extra_deps = [ "//src/shell/lynx:lynx_lib" ]
  lynxtron_app_extra_configs = []
  lynxtron_app_extra_deps = []
  lynxtron_asar_extra_deps = []
  lynxtron_resource_fetcher_deps = [ "//src/shell/lynx/resource_fetcher" ]
  lynxtron_app_resources_deps = [ "//src/shell/lynx:lynx_resources" ]
  lynxtron_lib_browser_module_list_path = []
  lynxtron_extension_extra_deps = []
}
