+   windowless_renderer_->send_key_event = [this](lynx_key_event_t* event) {
+     static_assert(sizeof(lynx_key_event_t) == sizeof(ClayKeyEvent),
+                   "Key event size not match");
++    // IME text must go through the keyboard bridge, which reaches PageView's
++    // IME listener. Physical keys keep the normal focus manager path below.
++    // kLynxKeyEventTypeRepeat is reused by the windowless host to mark
++    // still-composing (pre-edit) text, which the editor renders as marked text
++    // until a subsequent commit or an empty composing string clears it.
++    if (event->synthesized && event->character &&
++        (event->type == kLynxKeyEventTypeDown ||
++         event->type == kLynxKeyEventTypeRepeat)) {
++      auto timestamp = static_cast<uint64_t>(event->timestamp);
++      if (event->type == kLynxKeyEventTypeRepeat) {
